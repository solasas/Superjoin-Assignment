# Copy this file to .env and fill in what you use.

# Which LLM backend to use for extraction + relation reasoning.
#   claude_cli    -> shells out to the local `claude` CLI (Claude Code), using
#                    whatever account it's already logged into. No API key
#                    needed, but requires `claude` installed + authenticated
#                    on this machine. Slower (process spawn + full CLI
#                    startup per call) but zero extra setup if you already
#                    have Claude Code.
#   anthropic_api -> calls the Anthropic Messages API directly with an API
#                    key. Faster and cheaper per call, portable to any
#                    machine/CI. Needs ANTHROPIC_API_KEY below.
LLM_BACKEND=claude_cli

# Only needed when LLM_BACKEND=anthropic_api
ANTHROPIC_API_KEY=

# Model used for fact extraction (cheaper/faster model is fine here)
EXTRACTION_MODEL=claude-haiku-4-5

# Model used for pairwise relation reasoning (benefits from a stronger model)
RELATION_MODEL=claude-sonnet-4-5

# Timeout (seconds) for a single LLM call
LLM_TIMEOUT_SECONDS=150

# Max concurrent LLM calls during ingestion
LLM_CONCURRENCY=4

# SQLite database path
DB_PATH=data/knowledge.db

# Where uploaded PDFs are stored
UPLOAD_DIR=data/uploads
